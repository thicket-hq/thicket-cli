{
  "name": "thicket-cli",
  "version": "0.3.0",
  "description": "Official command-line interface for Thicket (thickethq.com): projects, to-dos, messages, docs and files, boards, chat, search, reports, timesheets, notifications, cheers, and the local agent connector, from your terminal or through AI agents.",
  "keywords": [
    "thicket",
    "cli",
    "api",
    "project-management",
    "agent",
    "claude-code",
    "connector",
    "notifications",
    "timesheets",
    "time-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thicket-hq/thicket-cli.git"
  },
  "homepage": "https://github.com/thicket-hq/thicket-cli#readme",
  "type": "module",
  "bin": {
    "thicket": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "hooks",
    "README.md",
    "install.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "marked": "18.0.11",
    "picocolors": "^1.1.0",
    "thicket-sdk": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
